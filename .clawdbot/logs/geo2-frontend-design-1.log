from __future__ import annotations

import json
from dataclasses import dataclass
from datetime import datetime, timezone
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any
from urllib.parse import parse_qs, urlparse


@dataclass(frozen=True)
class RunSummary:
    run_id: str
    generated_at: str
    metrics: dict[str, int]
    entities: list[dict[str, str]]
    recommendations: list[str]

    def as_dict(self) -> dict[str, Any]:
        return {
            \"runId\": self.run_id,
            \"generatedAt\": self.generated_at,
            \"metrics\": self.metrics,
            \"entities\": self.entities,
            \"recommendations\": self.recommendations,
        }


def _read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding=\"utf-8\"))


def _latest_run_dir(out_dir: Path) -> Path | None:
    if not out_dir.exists():
        return None
    candidates = [child for child in out_dir.iterdir() if child.is_dir()]
    if not candidates:
        return None
    return sorted(candidates, key=lambda child: child.stat().st_mtime, reverse=True)[0]


def build_summary_payload(out_dir: Path, run_id: str | None = None) -> dict[str, Any]:
    run_dir = out_dir / run_id if run_id else _latest_run_dir(out_dir)
    generated_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M UTC\")

    if run_dir is None or not run_dir.exists():
        return RunSummary(
            run_id=\"none\",
            generated_at=generated_at,
            metrics={\"entities\": 0, \"relationships\": 0, \"coverage\": 0},
            entities=[],
            recommendations=[
                \"Run "'`geo2-run examples/content/recipes/sample.txt --out-dir out --run-id demo` to generate artifacts.",
                "Reload this screen to view live metrics from your latest run.",
            ],
        ).as_dict()

    graph_path = run_dir / "authority-graph.json"
    inclusion_path = run_dir / "inclusion-index.json"
    brief_path = run_dir / "reinforcement-brief.json"

    entities: list[dict[str, str]] = []
    metrics = {"entities": 0, "relationships": 0, "coverage": 0}
    recommendations: list[str] = []

    if graph_path.exists():
        graph = _read_json(graph_path)
        graph_entities = graph.get("entities", [])
        entities = [
            {
                "name": str(entity.get("name", "Unknown")),
                "type": str(entity.get("type", "unspecified")),
                "authority": str(entity.get("authoritySignal", "n/a")),
            }
            for entity in graph_entities[:6]
            if isinstance(entity, dict)
        ]
        metrics["entities"] = len(graph_entities)
        metrics["relationships"] = len(graph.get("relationships", []))

    if inclusion_path.exists():
        inclusion = _read_json(inclusion_path)
        coverage = inclusion.get("summary", {}).get("coverageScore")
        if isinstance(coverage, (int, float)):
            metrics["coverage"] = int(round(coverage))

    if brief_path.exists():
        brief = _read_json(brief_path)
        for action in brief.get("priorityActions", [])[:4]:
            if isinstance(action, str):
                recommendations.append(action)

    if not recommendations:
        recommendations = [
            "No reinforcement priorities found for this run.",
            "Generate a reinforcement brief to populate this section.",
        ]

    return RunSummary(
        run_id=run_dir.name,
        generated_at=generated_at,
        metrics=metrics,
        entities=entities,
        recommendations=recommendations,
    ).as_dict()


class GeoUIRequestHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args: Any, static_dir: Path, out_dir: Path, **kwargs: Any) -> None:
        self._out_dir = out_dir
        super().__init__(*args, directory=str(static_dir), **kwargs)

    def do_GET(self) -> None:  # noqa: N802
        parsed = urlparse(self.path)
        if parsed.path == "/api/summary":
            query = parse_qs(parsed.query)
            run_id = query.get("run_id", [None])[0]
            payload = build_summary_payload(self._out_dir, run_id)
            body = json.dumps(payload).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        if parsed.path in {"", "/"}:
            self.path = "/index.html"
        else:
            self.path = parsed.path
        super().do_GET()


def serve_ui(*, host: str, port: int, out_dir: Path, run_id: str | None = None) -> None:
    static_dir = Path(__file__).parent / "static"

    class RunBoundHandler(GeoUIRequestHandler):
        def __init__(self, *args: Any, **kwargs: Any) -> None:
            super().__init__(*args, static_dir=static_dir, out_dir=out_dir, **kwargs)

    server = ThreadingHTTPServer((host, port), RunBoundHandler)
    print(f"Geo2 UI listening on http://{host}:{port}")
    if run_id:
        print(f"Pinned run id: {run_id}")
    print(f"Using out dir: {out_dir}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
