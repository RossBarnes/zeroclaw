class ExtractTests(unittest.TestCase):
    def test_html_to_text_removes_script_and_style(self) -> None:
        html = \"\"\"
        <html><head><style>.x{color:red}</style><script>alert(1)</script></head>
        <body><h1>Geo2</h1><p>Hello world.</p></body></html>
        \"\"\"
        text = html_to_text(html)
        self.assertEqual(text, \"Geo2 Hello world.\")

    @patch(\"src.pipeline.extract.urllib.request.urlopen\")
    def test_fetch_url_text_handles_html(self, mock_urlopen: MagicMock) -> None:
        response = MagicMock()
        response.read.return_value = b\"<html><body><h1>Title</h1><p>Body text</p></body></html>\"
        response.geturl.return_value = \"https://example.com\"
        response.headers.get.side_effect = lambda key, default=\"\": {
            \"Content-Type\": \"text/html; charset=utf-8\",
            \"Content-Length\": \"60\",
        }.get(key, default)
        mock_urlopen.return_value.__enter__.return_value = response

        text = fetch_url_text(\"https://example.com\")
        self.assertEqual(text, \"Title Body text\")

    def test_fetch_url_text_rejects_invalid_protocol(self) -> None:
        with self.assertRaises(URLIngestError) as ctx:
            fetch_url_text(\"ftp://example.com/file.txt\")
        self.assertIn(\"INVALID_URL\", str(ctx.exception))

    def test_fetch_url_text_rejects_blocked_domain(self) -> None:
        with self.assertRaises(URLIngestError) as ctx:
            fetch_url_text(\"http://localhost/internal\")
        self.assertIn(\"BLOCKED_DOMAIN\", str(ctx.exception))

    @patch(\"src.pipeline.extract.urllib.request.urlopen\", side_effect=TimeoutError(\"timed out\"))
    def test_fetch_url_text_raises_timeout_error(self, _mock_urlopen: MagicMock) -> None:
        with self.assertRaises(URLIngestError) as ctx:
            fetch_url_text(\"https://example.com\")
        self.assertIn(\"TIMEOUT\", str(ctx.exception))

    @patch(\"src.pipeline.extract.urllib.request.urlopen\")
    def test_fetch_url_text_rejects_oversized_response(self, mock_urlopen: MagicMock) -> None:
        response = MagicMock()
        response.geturl.return_value = \"https://example.com\"
        response.headers.get.side_effect = lambda key, default=\"\": {
            \"Content-Type\": \"text/plain; charset=utf-8\",
            \"Content-Length\": str(DEFAULT_MAX_RESPONSE_BYTES + 1),
        }.get(key, default)
        mock_urlopen.return_value.__enter__.return_value = response

        with self.assertRaises(URLIngestError) as ctx:
            fetch_url_text(\"https://example.com\")
        self.assertIn(\"OVERSIZED_RESPONSE\", str(ctx.exception))


if __name__ == \"__main__\":
    unittest.main()
