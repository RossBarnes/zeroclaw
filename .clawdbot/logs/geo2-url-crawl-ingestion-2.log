        type=int,
        default=DEFAULT_URL_TIMEOUT_SECONDS,
        help=f\"Request timeout in seconds (default: {DEFAULT_URL_TIMEOUT_SECONDS})\",
    )
    parser.add_argument(
        \"--max-bytes\",
        type=int,
        default=DEFAULT_MAX_RESPONSE_BYTES,
        help=f\"Maximum response body size in bytes (default: {DEFAULT_MAX_RESPONSE_BYTES})\",
    )
    parser.add_argument(
        \"--blocked-domain\",
        dest=\"blocked_domains\",
        action=\"append\",
        default=None,
        help=\"Domain to block (can be repeated, defaults include localhost/private metadata hosts)\",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    blocked_domains = tuple(args.blocked_domains) if args.blocked_domains else DEFAULT_BLOCKED_DOMAINS

    if args.timeout_seconds <= 0:
        raise SystemExit(\"ERROR: --timeout-seconds must be greater than 0\")
    if args.max_bytes <= 0:
        raise SystemExit(\"ERROR: --max-bytes must be greater than 0\")

    try:
        result = ingest_url_to_artifacts(
            url=args.url,
            out_dir=args.out_dir,
            name=args.name,
            timeout_seconds=args.timeout_seconds,
            max_response_bytes=args.max_bytes,
            blocked_domains=blocked_domains,
        )
    except URLIngestError as err:
        raise SystemExit(f\"ERROR: {err}\") from err

    print(str(result.output_path))
    print(str(result.manifest_path))
    print(
        f\"crawl url={result.crawl.final_url} bytes={result.crawl.bytes_fetched} \"
        f\"contentType={result.crawl.content_type or 'unknown'}\"
    )


if __name__ == \"__main__\":
    main()
