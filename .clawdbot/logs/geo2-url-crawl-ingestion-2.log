from __future__ import annotations

import ipaddress
import re
import urllib.error
import urllib.request
from dataclasses import dataclass
from html.parser import HTMLParser
from urllib.parse import urlparse

DEFAULT_URL_TIMEOUT_SECONDS = 20
DEFAULT_MAX_RESPONSE_BYTES = 2_000_000
DEFAULT_BLOCKED_DOMAINS = (
    \"localhost\",
    \"localdomain\",
    \"metadata.google.internal\",
    \"169.254.169.254\",
)
BLOCKED_DOMAIN_SUFFIXES = (\".local\", \".internal\")
_ALLOWED_CONTENT_TYPE_MARKERS = (\"text/\", \"json\", \"xml\", \"javascript\")


class URLIngestError(RuntimeError):
    \"\"\"Raised when URL content cannot be fetched or parsed.\"\"\"


@dataclass(frozen=True)
class URLCrawlResult:
    source_url: str
    final_url: str
    content_type: str
    bytes_fetched: int
    text: str


class _VisibleTextHTMLParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self._chunks: list[str] = []
        self._skip_depth = 0

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in {\"script\", \"style\", \"noscript\"}:
            self._skip_depth += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in {\"script\", \"style\", \"noscript\"} and self._skip_depth > 0:
            self._skip_depth -= 1

    def handle_data(self, data: str) -> None:
        if self._skip_depth == 0:
            self._chunks.append(data)

    def text(self) -> str:
        raw = \" \".join(self._chunks)
        return _normalize_text(raw)


def _normalize_text(text: str) -> str:
    return re.sub(r\"\\s+\", \" \", text).strip()


def _error(code: str, detail: str) -> URLIngestError:
    return URLIngestError(f\"{code}: {detail}\")


def _is_blocked_domain(hostname: str, blocked_domains: tuple[str, ...]) -> bool:
    lowered_host = hostname.lower()
    for blocked in blocked_domains:
        candidate = blocked.strip().lower()
        if not candidate:
            continue
        if lowered_host == candidate or lowered_host.endswith(f\".{candidate}\"):
            return True
    return lowered_host.endswith(BLOCKED_DOMAIN_SUFFIXES)


def _is_unsafe_ip(hostname: str) -> bool:
    try:
        ip = ipaddress.ip_address(hostname)
    except ValueError:
        return False

    return (
        ip.is_private
        or ip.is_loopback
        or ip.is_link_local
        or ip.is_multicast
        or ip.is_reserved
        or ip.is_unspecified
    )


def _validate_url(url: str, blocked_domains: tuple[str, ...]) -> None:
    parsed = urlparse(url)

    if parsed.scheme not in {\"http\", \"https\"}:
        raise _error(\"INVALID_URL\", f\"Unsupported protocol for URL: {url}\")

    if not parsed.hostname:
        raise _error(\"INVALID_URL\", f\"URL must include a hostname: {url}\")

    if parsed.username or parsed.password:
        raise _error(\"UNSAFE_URL\", f\"URLs with user info are not supported: {url}\")

    hostname = parsed.hostname.strip().lower()
    if _is_blocked_domain(hostname, blocked_domains) or _is_unsafe_ip(hostname):
        raise _error(\"BLOCKED_DOMAIN\", f\"Blocked or unsafe domain: {hostname}\")


def html_to_text(html: str) -> str:
    parser = _VisibleTextHTMLParser()
    parser.feed(html)
    return parser.text()


def crawl_url(
    url: str,
    *,
    timeout_seconds: int = DEFAULT_URL_TIMEOUT_SECONDS,
    max_response_bytes: int = DEFAULT_MAX_RESPONSE_BYTES,
    blocked_domains: tuple[str, ...] = DEFAULT_BLOCKED_DOMAINS,
) -> URLCrawlResult:
    _validate_url(url, blocked_domains)

    request = urllib.request.Request(
        url=url,
        headers={\"User-Agent\": \"geo2-ingest-url/0.2\"},
        method=\"GET\",
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:  # noqa: S310 - explicit user URL
            content_type = response.headers.get(\"Content-Type\", \"\").lower()
            content_length_header = response.headers.get(\"Content-Length\", \"\").strip()

            if content_length_header.isdigit() and int(content_length_header) > max_response_bytes:
                raise _error(\"OVERSIZED_RESPONSE\", f\"Response exceeded {max_response_bytes} bytes\")

            payload = response.read(max_response_bytes + 1)
            final_url = response.geturl()
    except URLIngestError:
        raise
    except TimeoutError as err:
        raise _error(\"TIMEOUT\", f\"Timed out after {timeout_seconds}s while fetching URL: {url}\") from err
    except urllib.error.URLError as err:
        if isinstance(getattr(err, \"reason\", None), TimeoutError):
            raise _error(\"TIMEOUT\", f\"Timed out after {timeout_seconds}s while fetching URL: {url}\") from err
        raise _error(\"FETCH_FAILED\", f\"Unable to fetch URL: {url}\") from err
    except OSError as err:
        raise _error(\"FETCH_FAILED\", f\"Unable to fetch URL: {url}\") from err

    if len(payload) > max_response_bytes:
        raise _error(\"OVERSIZED_RESPONSE\", f\"Response exceeded {max_response_bytes} bytes\")

    if content_type and not any(marker in content_type for marker in _ALLOWED_CONTENT_TYPE_MARKERS):
        raise _error(\"UNSUPPORTED_CONTENT_TYPE\", f\"Unsupported content type: {content_type}\")

    decoded = payload.decode(\"utf-8\", errors=\"replace\")
    if \"text/html\" in content_type or \"<html\" in decoded.lower():
        text = html_to_text(decoded)
    else:
        text = _normalize_text(decoded)

    if not text:
        raise _error(\"EMPTY_CONTENT\", f\"No extractable text content at URL: {url}\")

    return URLCrawlResult(
        source_url=url,
        final_url=final_url,
        content_type=content_type,
        bytes_fetched=len(payload),
        text=text,
    )


def fetch_url_text(
    url: str,
    *,
    timeout_seconds: int = DEFAULT_URL_TIMEOUT_SECONDS,
    max_response_bytes: int = DEFAULT_MAX_RESPONSE_BYTES,
    blocked_domains: tuple[str, ...] = DEFAULT_BLOCKED_DOMAINS,
) -> str:
    return crawl_url(
        url,
        timeout_seconds=timeout_seconds,
        max_response_bytes=max_response_bytes,
        blocked_domains=blocked_domains,
    ).text
