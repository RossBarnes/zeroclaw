from __future__ import annotations

import re
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import urlparse

from src.pipeline.core import build_output_document, build_run_manifest, write_json
from src.pipeline.extract import (
    DEFAULT_BLOCKED_DOMAINS,
    DEFAULT_MAX_RESPONSE_BYTES,
    DEFAULT_URL_TIMEOUT_SECONDS,
    URLCrawlResult,
    crawl_url,
)


@dataclass(frozen=True)
class URLIngestionResult:
    output_path: Path
    manifest_path: Path
    crawl: URLCrawlResult


def slug_from_url(url: str) -> str:
    parsed = urlparse(url)
    stem = Path(parsed.path).stem or parsed.netloc or \"url\"
    slug = re.sub(r\"["'^a-zA-Z0-9._-]+", "-", stem).strip("-")
    return slug or "url"


def ingest_url_to_artifacts(
    *,
    url: str,
    out_dir: Path,
    name: str | None = None,
    timeout_seconds: int = DEFAULT_URL_TIMEOUT_SECONDS,
    max_response_bytes: int = DEFAULT_MAX_RESPONSE_BYTES,
    blocked_domains: tuple[str, ...] = DEFAULT_BLOCKED_DOMAINS,
) -> URLIngestionResult:
    stem = name.strip() if isinstance(name, str) and name.strip() else slug_from_url(url)
    pseudo_input_path = Path(f"{stem}.txt")
    output_path = out_dir / f"{stem}.json"
    manifest_path = out_dir / f"{stem}.manifest.json"

    crawl = crawl_url(
        url,
        timeout_seconds=timeout_seconds,
        max_response_bytes=max_response_bytes,
        blocked_domains=blocked_domains,
    )

    document = build_output_document(input_path=pseudo_input_path, text=crawl.text)
    manifest = build_run_manifest(input_path=Path(url), output_path=output_path, document=document)
    manifest["crawl"] = {
        "sourceUrl": crawl.source_url,
        "finalUrl": crawl.final_url,
        "contentType": crawl.content_type,
        "bytesFetched": crawl.bytes_fetched,
        "timeoutSeconds": timeout_seconds,
        "maxResponseBytes": max_response_bytes,
        "blockedDomains": sorted(set(blocked_domains)),
    }

    write_json(output_path, document)
    write_json(manifest_path, manifest)

    return URLIngestionResult(output_path=output_path, manifest_path=manifest_path, crawl=crawl)
