def _slug_from_url(url: str) -> str:
    parsed = urlparse(url)
    stem = Path(parsed.path).stem or parsed.netloc or "url"
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", stem).strip("-")
    return slug or "url"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Ingest content from a URL and emit structured JSON.")
