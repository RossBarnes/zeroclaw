#!/usr/bin/env bash
# clawdbot — Agent swarm orchestration CLI for ZeroClaw.
#
# Usage:
#   clawdbot create <task-id> "<description>" [agent-type] [--repo <path>]
#   clawdbot kickoff <task-id> <brief-file> [agent-type] [--repo <path>]
#   clawdbot spawn  <task-id>
#   clawdbot queue-add <task-id> <brief-file> [agent-type] [--repo <path>] [--priority <0-100>]
#   clawdbot queue-status
#   clawdbot check
#   clawdbot autopilot [--loop] [--interval-seconds N] [--max-launches N]
#   clawdbot status [task-id]
#   clawdbot validate
#   clawdbot help
#
# Environment:
#   AGENT_SWARM_HOME           — workspace root (default: ~/agent-swarm)
#   AGENT_SWARM_MAX_PARALLEL   — max concurrent agents (default: 1)
#   CLAWDBOT_USE_TMUX          — set to 1 to use tmux sessions (default: 0)
#   CLAWDBOT_CHECK_TMUX        — set to 1 to enforce tmux session liveness in checks
#   TELEGRAM_BOT_TOKEN         — optional Telegram bot token for ready notifications
#   TELEGRAM_CHAT_ID           — optional Telegram chat id for ready notifications
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAWDBOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REGISTRY="$CLAWDBOT_DIR/registry/active-tasks.json"
VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die()  { echo "error: $*" >&2; exit 1; }

print_help() {
  cat <<'EOF'
clawdbot — Agent Swarm Orchestration for ZeroClaw

Usage:
  clawdbot create <task-id> "<description>" [agent-type] [--repo <path>]
  clawdbot kickoff <task-id> <brief-file> [agent-type] [--repo <path>]
  clawdbot spawn  <task-id>
  clawdbot queue-add <task-id> <brief-file> [agent-type] [--repo <path>] [--priority <0-100>]
  clawdbot queue-status
  clawdbot check
  clawdbot autopilot [--loop] [--interval-seconds N] [--max-launches N]
  clawdbot status [task-id]
  clawdbot validate
  clawdbot help
  clawdbot version

Commands:
  create    Create a new task with an isolated git worktree
            agent-type: codex | claude (default: claude)

  spawn     Launch a coding agent against a task worktree

  kickoff   Create a task from a technical brief and immediately spawn it

  queue-add Add a task brief to backlog for automatic scheduling

  queue-status Show queued/in-progress/done backlog items

  autopilot Run deterministic scheduler tick (or loop mode)

  check     Run supervisor check on all active tasks (uses gh CLI)

  status    Show task status (all tasks, or a specific task by id)

  validate  Validate the active-tasks.json registry schema

  help      Show this help message

  version   Show version

Environment Variables:
  AGENT_SWARM_HOME           Workspace root directory (default: ~/agent-swarm)
  AGENT_SWARM_MAX_PARALLEL   Max concurrent agents (default: 1)
  CLAWDBOT_USE_TMUX          Use tmux for agent sessions (default: 0)
  CLAWDBOT_CHECK_TMUX        Enforce tmux liveness in supervisor checks (default: 0)
  TELEGRAM_BOT_TOKEN         Optional Telegram bot token for ready notifications
  TELEGRAM_CHAT_ID           Optional Telegram chat id for ready notifications

Examples:
  clawdbot create fix-auth "Fix the OAuth token refresh bug"
  clawdbot create fix-auth "Fix auth bug" codex --repo /path/to/repo
  clawdbot kickoff billing-refactor ./briefs/billing-refactor.md codex --repo /path/to/repo
  clawdbot create add-search "Add full-text search to memory" codex
  clawdbot queue-add ui-polish .clawdbot/briefs/ui-polish.md codex --repo /path/to/repo --priority 80
  clawdbot autopilot --loop --interval-seconds 180
  clawdbot spawn fix-auth
  clawdbot check
  clawdbot status fix-auth
EOF
}

print_status() {
  local task_id="${1:-}"

  if ! command -v jq >/dev/null 2>&1; then
    die "jq is required but not installed."
  fi

  if [ ! -f "$REGISTRY" ]; then
    echo "No registry found. No tasks created yet."
    return
  fi

  if [ -n "$task_id" ]; then
    # Single task
    local task
    task="$(jq --arg id "$task_id" '.tasks[] | select(.id == $id)' "$REGISTRY")"
    if [ -z "$task" ]; then
      die "Task '$task_id' not found."
    fi
    echo "$task" | jq '.'
  else
    # All tasks
    local count
    count="$(jq '.tasks | length' "$REGISTRY")"
    echo "Tasks: $count total"
    echo ""
    if [ "$count" -eq 0 ]; then
      echo "No tasks. Create one with: clawdbot create <task-id> \"<description>\""
      return
    fi
    printf "  %-24s %-10s %-8s %-30s %s\n" "ID" "STATUS" "AGENT" "BRANCH" "DESCRIPTION"
    printf "  %-24s %-10s %-8s %-30s %s\n" "---" "---" "---" "---" "---"
    jq -r '.tasks[] | "\(.id)|\(.status)|\(.agent_type)|\(.branch)|\(.description[0:50])"' "$REGISTRY" | while IFS='|' read -r tid tstatus tagent tbranch tdesc; do
      printf "  %-24s %-10s %-8s %-30s %s\n" "$tid" "$tstatus" "$tagent" "$tbranch" "$tdesc"
    done
  fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
  if [ $# -lt 1 ]; then
    print_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    create)
      if [ $# -lt 2 ]; then
        echo "Usage: clawdbot create <task-id> \"<description>\" [agent-type] [--repo <path>]" >&2
        exit 1
      fi
      local task_id="$1"
      local description="$2"
      shift 2
      local agent_type="claude"
      local repo_path=""
      if [ "${1:-}" != "" ] && [ "${1:-}" != "--repo" ]; then
        agent_type="$1"
        shift
      fi
      if [ "${1:-}" = "--repo" ]; then
        [ -n "${2:-}" ] || die "--repo requires a path"
        repo_path="$2"
      fi
      exec "$SCRIPT_DIR/create_task" "$task_id" "$description" "origin/main" "$repo_path" "$agent_type"
      ;;

    spawn)
      if [ $# -lt 1 ]; then
        echo "Usage: clawdbot spawn <task-id>" >&2
        exit 1
      fi
      exec "$SCRIPT_DIR/spawn_agent" "$1"
      ;;

    kickoff)
      if [ $# -lt 2 ]; then
        echo "Usage: clawdbot kickoff <task-id> <brief-file> [agent-type] [--repo <path>]" >&2
        exit 1
      fi
      local task_id="$1"
      local brief_file="$2"
      shift 2
      local agent_type="claude"
      local repo_path=""
      if [ "${1:-}" != "" ] && [ "${1:-}" != "--repo" ]; then
        agent_type="$1"
        shift
      fi
      if [ "${1:-}" = "--repo" ]; then
        [ -n "${2:-}" ] || die "--repo requires a path"
        repo_path="$2"
      fi
      exec "$SCRIPT_DIR/kickoff_task" "$task_id" "$brief_file" "$agent_type" "$repo_path"
      ;;

    check)
      exec "$SCRIPT_DIR/supervisor_check"
      ;;

    queue-add)
      exec "$SCRIPT_DIR/queue_add" "$@"
      ;;

    queue-status)
      exec "$SCRIPT_DIR/queue_status"
      ;;

    autopilot)
      exec "$SCRIPT_DIR/autopilot_tick" "$@"
      ;;

    status)
      print_status "${1:-}"
      ;;

    validate)
      exec "$SCRIPT_DIR/validate_registry"
      ;;

    version)
      echo "clawdbot $VERSION"
      ;;

    help|--help|-h)
      print_help
      ;;

    *)
      die "Unknown command: $cmd. Run 'clawdbot help' for usage."
      ;;
  esac
}

main "$@"
